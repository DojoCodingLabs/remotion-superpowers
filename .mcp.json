{
  "mcpServers": {
    "ElevenLabs": {
      "command": "uvx",
      "args": [
        "elevenlabs-mcp==0.12.2"
      ],
      "env": {
        "ELEVENLABS_MCP_BASE_PATH": "./public",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      },
      "env_vars": [
        "ELEVENLABS_API_KEY"
      ]
    },
    "remotion-media": {
      "command": "npx",
      "args": [
        "-y",
        "remotion-media-mcp@1.2.2"
      ],
      "env_vars": [
        "KIE_API_KEY"
      ]
    },
    "TwelveLabs": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "twelvelabs-mcp@1.0.0",
        "twelvelabs-mcp-stdio"
      ],
      "env_vars": [
        "TWELVELABS_API_KEY"
      ]
    },
    "Pexels": {
      "command": "npx",
      "args": [
        "-y",
        "@hanoak/pexels-mcp-server@1.0.2"
      ],
      "env_vars": [
        "PEXELS_API_KEY"
      ]
    },
    "Replicate": {
      "command": "npx",
      "args": [
        "-y",
        "replicate-mcp@0.9.0"
      ],
      "env_vars": [
        "REPLICATE_API_TOKEN"
      ]
    }
  }
}
