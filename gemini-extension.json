{
  "name": "remotion-superpowers",
  "version": "2.2.0",
  "description": "Full video production pipeline for Remotion — gives Claude eyes (video analysis), voice (TTS/voiceover), ears (music/SFX), stock footage, AI image/video generation, TikTok captions, 3D content, and more. By Dojo Coding Labs.",
  "mcpServers": {
    "remotion-media": {
      "command": "npx",
      "args": [
        "remotion-media-mcp"
      ]
    },
    "ElevenLabs": {
      "command": "uvx",
      "args": [
        "elevenlabs-mcp"
      ],
      "env": {
        "ELEVENLABS_MCP_BASE_PATH": "./public/audio",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      }
    },
    "TwelveLabs": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "twelvelabs-mcp",
        "twelvelabs-mcp-stdio"
      ]
    },
    "Pexels": {
      "command": "uvx",
      "args": [
        "pexels-mcp-server"
      ]
    },
    "Replicate": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.replicate.com/sse"
      ]
    }
  },
  "settings": [
    {
      "name": "KIE API key",
      "description": "Primary key for voiceover, music, sound effects, image and video generation (https://kie.ai)",
      "envVar": "KIE_API_KEY",
      "sensitive": true
    },
    {
      "name": "TwelveLabs API key",
      "description": "Video analysis and AI review (https://www.twelvelabs.io)",
      "envVar": "TWELVELABS_API_KEY",
      "sensitive": true
    },
    {
      "name": "Pexels API key",
      "description": "Free stock footage (https://www.pexels.com/api/)",
      "envVar": "PEXELS_API_KEY",
      "sensitive": true
    },
    {
      "name": "ElevenLabs API key",
      "description": "Optional: advanced voice features (https://elevenlabs.io)",
      "envVar": "ELEVENLABS_API_KEY",
      "sensitive": true
    },
    {
      "name": "Replicate API token",
      "description": "Optional: extra AI image/video models (https://replicate.com)",
      "envVar": "REPLICATE_API_TOKEN",
      "sensitive": true
    }
  ]
}
